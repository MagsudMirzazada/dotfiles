# macOS packages for these dotfiles. Install with: brew bundle --file=Brewfile
# Ghostty is not listed. Install it from https://ghostty.org or: brew install --cask ghostty

brew "stow"
brew "tmux"
brew "fzf"
brew "bat"
brew "ripgrep"
brew "tree"
brew "starship"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Optional: Ghostty already bundles Nerd Font symbols. Only needed to use FiraCode as the font.
cask "font-fira-code-nerd-font"
